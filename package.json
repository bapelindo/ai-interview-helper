{
  "name": "ai-interview-helper",
  "version": "2.0.1",
  "description": "Free, open-source AI interview assistant: real-time answers from voice transcription and screenshots. Works with Groq, Claude, Gemini, OpenAI, DeepSeek, Z.ai and local Ollama.",
  "keywords": [
    "ai interview assistant",
    "interview helper",
    "interview copilot",
    "ai interview",
    "coding interview",
    "job interview",
    "electron",
    "whisper",
    "speech-to-text",
    "llm",
    "groq",
    "claude",
    "gemini",
    "openai",
    "ollama"
  ],
  "homepage": "https://github.com/pyk-boo/ai-interview-helper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyk-boo/ai-interview-helper.git"
  },
  "bugs": {
    "url": "https://github.com/pyk-boo/ai-interview-helper/issues"
  },
  "author": "pyk-boo",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.ai.bot",
    "productName": "AI Interview Helper",
    "executableName": "AI Interview Helper",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "publish": null,
    "win": {
      "executableName": "AI Interview Helper",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AI-Interview-Helper-Setup.${ext}"
    },
    "portable": {
      "artifactName": "AI-Interview-Helper-Portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Microphone access is required for voice transcription.",
        "NSCameraUsageDescription": "Not used."
      }
    }
  }
}
